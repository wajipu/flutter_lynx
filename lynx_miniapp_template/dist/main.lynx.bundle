{
  "header": {
    "magic": "LYNX_BUNDLE_V1",
    "compiler": "react-lynx-rspeedy-bundler",
    "timestamp": "2026-09-08T11:49:38.005Z"
  },
  "manifest": {
    "appId": "kmanager_local_demo",
    "name": "KManager Lynx Mini-Program",
    "version": "1.0.0",
    "description": "Dynamic Mini Program template for KManager powered by Lynx (https://lynxjs.org/)",
    "entry": "src/index.tsx",
    "pages": [
      "pages/index"
    ]
  },
  "sources": {
    "src/index.tsx": "import { useState, useEffect } from \"@lynx-js/react\";\nimport { LynxBridge, UserInfo, SystemInfo } from \"./bridge\";\nimport \"./styles.css\";\n\nexport default function App() {\n  const [activeTab, setActiveTab] = useState<number>(0);\n  const [userInfo, setUserInfo] = useState<UserInfo | null>(null);\n  const [systemInfo, setSystemInfo] = useState<SystemInfo | null>(null);\n  const [lastActionResult, setLastActionResult] = useState<string>(\"尚未触发操作\");\n\n  // Report state\n  const [reportPeriod, setReportPeriod] = useState<string>(\"今日实时\");\n  const [selectedHourIdx, setSelectedHourIdx] = useState<number>(4);\n\n  // Order state\n  const [selectedCat, setSelectedCat] = useState<number>(0);\n  const [cart, setCart] = useState<Record<string, number>>({});\n\n  useEffect(() => {\n    LynxBridge.getUserInfo().then(setUserInfo).catch(console.error);\n    LynxBridge.getSystemInfo().then(setSystemInfo).catch(console.error);\n  }, []);\n\n  const handleScanQR = async () => {\n    try {\n      setLastActionResult(\"正在唤起宿主扫码组件...\");\n      const result = await LynxBridge.scanQRCode();\n      setLastActionResult(`扫码结果: ${result.code}`);\n      LynxBridge.showToast(\"扫码成功\", \"success\");\n    } catch (e: any) {\n      setLastActionResult(`扫码失败: ${e.message}`);\n    }\n  };\n\n  const handleRequest = async (url: string) => {\n    try {\n      setLastActionResult(`正在通过宿主网络代理请求: ${url}...`);\n      const res = await LynxBridge.request({ url, method: \"GET\" });\n      setLastActionResult(`请求成功:\\n${JSON.stringify(res, null, 2)}`);\n      LynxBridge.showToast(\"接口请求成功\");\n    } catch (e: any) {\n      setLastActionResult(`请求失败: ${e.message}`);\n    }\n  };\n\n  const handleExportReport = async () => {\n    try {\n      setLastActionResult(\"正在通知宿主生成并导出 Excel 报表...\");\n      const res = await LynxBridge.invoke(\"exportReport\", { range: reportPeriod, format: \"xlsx\" }, \"report\");\n      setLastActionResult(`报表导出成功:\\n${JSON.stringify(res, null, 2)}`);\n      LynxBridge.showToast(\"Excel 导出完成\", \"success\");\n    } catch (e: any) {\n      setLastActionResult(`导出失败: ${e.message}`);\n    }\n  };\n\n  const handleShowModal = async () => {\n    const res = await LynxBridge.showModal(\"宿主原生弹窗\", \"确定要在 Lynx 小程序中执行此操作吗？\", true);\n    setLastActionResult(`Modal 结果: ${res.confirm ? \"点击了确定\" : \"点击了取消\"}`);\n  };\n\n  const handleToast = (msg: string) => {\n    LynxBridge.showToast(msg, \"success\");\n    setLastActionResult(`已触发宿主 Toast: ${msg}`);\n  };\n\n  const updateCart = (id: string, delta: number) => {\n    const next = { ...cart };\n    const cur = next[id] || 0;\n    const val = Math.max(0, cur + delta);\n    if (val === 0) delete next[id];\n    else next[id] = val;\n    setCart(next);\n  };\n\n  const hourlyData = [\n    { hour: \"10:00\", amount: 1280, orders: 18, height: 25 },\n    { hour: \"12:00\", amount: 5640, orders: 68, height: 85 },\n    { hour: \"14:00\", amount: 2180, orders: 26, height: 35 },\n    { hour: \"16:00\", amount: 1650, orders: 20, height: 28 },\n    { hour: \"18:00\", amount: 6820, orders: 82, height: 100 },\n    { hour: \"20:00\", amount: 6120, orders: 74, height: 90 },\n    { hour: \"22:00\", amount: 3480, orders: 32, height: 52 },\n    { hour: \"24:00\", amount: 1280, orders: 8, height: 20 },\n  ];\n\n  const curHour = hourlyData[selectedHourIdx];\n\n  return (\n    <view className=\"container\">\n      {/* Top Header Card */}\n      <view className=\"header-card\">\n        <text className=\"header-title\">Lynx 动态小程序 (ReactLynx TSX)</text>\n        <text className=\"header-subtitle\">宿主纯容器化驱动 • 100% 独立 TSX / CSS 代码</text>\n      </view>\n\n      {/* Tabs */}\n      <view className=\"tabs-bar\">\n        {[\"经营报表\", \"桌台看板\", \"扫码点餐\", \"会员中心\", \"宿主隧道\"].map((t, idx) => (\n          <view\n            key={idx}\n            className={`tab-item ${activeTab === idx ? \"tab-active\" : \"\"}`}\n            bindtap={() => setActiveTab(idx)}\n          >\n            <text className={`tab-text ${activeTab === idx ? \"tab-text-active\" : \"\"}`}>{t}</text>\n          </view>\n        ))}\n      </view>\n\n      {/* Tab 0: 经营分析与多维报表图表 */}\n      {activeTab === 0 && (\n        <view className=\"section-card\">\n          <view className=\"report-header-row\">\n            <view className=\"period-selector\">\n              {[\"今日实时\", \"近7天\", \"本月\"].map((p) => (\n                <view\n                  key={p}\n                  className={`period-btn ${reportPeriod === p ? \"period-active\" : \"\"}`}\n                  bindtap={() => setReportPeriod(p)}\n                >\n                  <text className=\"period-text\">{p}</text>\n                </view>\n              ))}\n            </view>\n            <view className=\"export-btn\" bindtap={handleExportReport}>\n              <text className=\"export-text\">📥 导出 Excel</text>\n            </view>\n          </view>\n\n          {/* KPI Metrics */}\n          <view className=\"kpi-grid\">\n            <view className=\"kpi-card\">\n              <text className=\"kpi-title\">今日营业总额</text>\n              <text className=\"kpi-val\">¥28,450.00</text>\n              <text className=\"kpi-sub kpi-green\">同比 +14.8% ↑</text>\n            </view>\n            <view className=\"kpi-card\">\n              <text className=\"kpi-title\">成交订单总量</text>\n              <text className=\"kpi-val\">328 单</text>\n              <text className=\"kpi-sub\">客单价 ¥86.7</text>\n            </view>\n            <view className=\"kpi-card\">\n              <text className=\"kpi-title\">餐台综合翻台率</text>\n              <text className=\"kpi-val\">3.6 次/日</text>\n              <text className=\"kpi-sub kpi-orange\">满座率 94%</text>\n            </view>\n            <view className=\"kpi-card\">\n              <text className=\"kpi-title\">会员消费贡献额</text>\n              <text className=\"kpi-val\">¥18,260.00</text>\n              <text className=\"kpi-sub kpi-purple\">占比 64.2%</text>\n            </view>\n          </view>\n\n          {/* Hourly Revenue Bar Chart */}\n          <view className=\"chart-card\">\n            <text className=\"chart-title\">分时营收与出单趋势柱状图</text>\n            <text className=\"chart-sub\">单位: 元 (点击柱形查看时段详情)</text>\n            <view className=\"bar-chart-container\">\n              {hourlyData.map((d, i) => (\n                <view\n                  key={d.hour}\n                  className={`bar-col ${selectedHourIdx === i ? \"bar-active\" : \"\"}`}\n                  bindtap={() => setSelectedHourIdx(i)}\n                >\n                  {selectedHourIdx === i && <text className=\"bar-tip\">¥{d.amount}</text>}\n                  <view className={`bar-pillar bar-h-${d.height} ${selectedHourIdx === i ? \"pillar-active\" : \"\"}`} />\n                  <text className=\"bar-label\">{d.hour}</text>\n                </view>\n              ))}\n            </view>\n            <view className=\"hour-detail-box\">\n              <text className=\"hour-detail-text\">\n                选中时段: {curHour.hour} | 营收: ¥{curHour.amount} | 出单: {curHour.orders} 单\n              </text>\n            </view>\n          </view>\n\n          {/* Category Donut / Progress Breakdown */}\n          <view className=\"chart-card\">\n            <text className=\"chart-title\">菜品类目营收结构占比</text>\n            <view className=\"progress-stack-bar\">\n              <view className=\"bar-seg seg-blue\" />\n              <view className=\"bar-seg seg-cyan\" />\n              <view className=\"bar-seg seg-orange\" />\n              <view className=\"bar-seg seg-purple\" />\n            </view>\n            <view className=\"legend-list\">\n              {[\n                { name: \"招牌锅底与主菜\", amt: \"¥11,949\", pct: \"42%\", dot: \"dot-blue\" },\n                { name: \"特色小吃与凉菜\", amt: \"¥7,397\", pct: \"26%\", dot: \"dot-cyan\" },\n                { name: \"鲜制特饮与酒水\", amt: \"¥5,121\", pct: \"18%\", dot: \"dot-orange\" },\n                { name: \"经典主食与甜点\", amt: \"¥3,983\", pct: \"14%\", dot: \"dot-purple\" },\n              ].map((c) => (\n                <view key={c.name} className=\"legend-row\">\n                  <view className={`legend-dot ${c.dot}`} />\n                  <text className=\"legend-name\">{c.name}</text>\n                  <text className=\"legend-amt\">{c.amt}</text>\n                  <text className=\"legend-pct\">{c.pct}</text>\n                </view>\n              ))}\n            </view>\n          </view>\n\n          {/* Top Sellers */}\n          <view className=\"chart-card\">\n            <text className=\"chart-title\">爆款单品销量与毛利排行 Top 4</text>\n            {[\n              { rank: \"1\", name: \"招牌秘制牛腩煲\", sales: \"142份\", rev: \"¥9,656\", margin: \"毛利 68%\" },\n              { rank: \"2\", name: \"潮汕鲜手打牛肉丸\", sales: \"98份\", rev: \"¥3,724\", margin: \"毛利 72%\" },\n              { rank: \"3\", name: \"生椰爆汁柠檬茶\", sales: \"86杯\", rev: \"¥1,548\", margin: \"毛利 81%\" },\n              { rank: \"4\", name: \"极佳级安格斯眼肉\", sales: \"45份\", rev: \"¥4,410\", margin: \"毛利 65%\" },\n            ].map((t) => (\n              <view key={t.rank} className=\"top-row\">\n                <view className=\"top-badge\"><text className=\"badge-text\">{t.rank}</text></view>\n                <view className=\"top-info\">\n                  <text className=\"top-name\">{t.name}</text>\n                  <text className=\"top-sales\">已售 {t.sales}</text>\n                </view>\n                <view className=\"top-money\">\n                  <text className=\"top-rev\">{t.rev}</text>\n                  <view className=\"margin-pill\"><text className=\"margin-text\">{t.margin}</text></view>\n                </view>\n              </view>\n            ))}\n          </view>\n        </view>\n      )}\n\n      {/* Tab 1: 桌台看板 */}\n      {activeTab === 1 && (\n        <view className=\"section-card\">\n          <text className=\"section-title\">餐饮桌台看板 (Grid 布局)</text>\n          <view className=\"desk-grid\">\n            {[\n              { name: \"大厅A01\", cap: \"4人\", status: \"就餐中\", amount: \"¥288\" },\n              { name: \"大厅A02\", cap: \"4人\", status: \"空闲\", amount: \"-\" },\n              { name: \"靠窗A05\", cap: \"2人\", status: \"就餐中\", amount: \"¥168\" },\n              { name: \"包厢B01\", cap: \"10人\", status: \"已预定\", amount: \"¥500\" },\n            ].map((d, i) => (\n              <view key={i} className=\"desk-card\" bindtap={() => handleToast(`已选择桌台: ${d.name}`)}>\n                <text className=\"desk-name\">{d.name}</text>\n                <text className=\"desk-cap\">{d.cap} • {d.status}</text>\n                <text className=\"desk-amt\">{d.amount}</text>\n              </view>\n            ))}\n          </view>\n        </view>\n      )}\n\n      {/* Tab 2: 扫码点餐 */}\n      {activeTab === 2 && (\n        <view className=\"section-card\">\n          <text className=\"section-title\">扫码点餐货架 (双列菜单布局)</text>\n          <view className=\"menu-container\">\n            <view className=\"cat-sidebar\">\n              {[\"热销榜\", \"精选主食\", \"特色小吃\", \"现调饮品\"].map((c, i) => (\n                <view\n                  key={i}\n                  className={`cat-btn ${selectedCat === i ? \"cat-active\" : \"\"}`}\n                  bindtap={() => setSelectedCat(i)}\n                >\n                  <text className=\"cat-text\">{c}</text>\n                </view>\n              ))}\n            </view>\n            <view className=\"product-list\">\n              {[\n                { id: \"p1\", name: \"招牌秘制牛腩煲\", price: 68 },\n                { id: \"p2\", name: \"潮汕鲜手打牛肉丸\", price: 38 },\n                { id: \"p3\", name: \"生椰爆汁柠檬茶\", price: 18 },\n              ].map((p) => (\n                <view key={p.id} className=\"product-row\">\n                  <view className=\"product-info\">\n                    <text className=\"product-name\">{p.name}</text>\n                    <text className=\"product-price\">¥{p.price}</text>\n                  </view>\n                  <view className=\"stepper\">\n                    <view className=\"step-btn\" bindtap={() => updateCart(p.id, -1)}>\n                      <text>-</text>\n                    </view>\n                    <text className=\"step-count\">{cart[p.id] || 0}</text>\n                    <view className=\"step-btn step-add\" bindtap={() => updateCart(p.id, 1)}>\n                      <text>+</text>\n                    </view>\n                  </view>\n                </view>\n              ))}\n            </view>\n          </view>\n        </view>\n      )}\n\n      {/* Tab 3: 会员中心 */}\n      {activeTab === 3 && (\n        <view className=\"section-card\">\n          <view className=\"vip-hero-card\">\n            <text className=\"vip-title\">黑金尊享 VIP 会员</text>\n            <text className=\"vip-sub\">积分余额: 3,580 • 储值 ¥1,280.00</text>\n          </view>\n          <view className=\"coupon-item\" bindtap={() => handleToast(\"已领取 ¥30 堂食立减券\")}>\n            <text className=\"coupon-val\">¥30</text>\n            <view className=\"coupon-info\">\n              <text className=\"coupon-title\">全场通用堂食无门槛立减券</text>\n              <text className=\"coupon-sub\">有效期至 2026-12-31</text>\n            </view>\n            <view className=\"coupon-action\"><text>领取</text></view>\n          </view>\n        </view>\n      )}\n\n      {/* Tab 4: 宿主隧道 */}\n      {activeTab === 4 && (\n        <view className=\"section-card\">\n          <text className=\"section-title\">宿主能力桥接隧道 (JSBridge)</text>\n          <view className=\"actions-grid\">\n            <view className=\"action-btn\" bindtap={handleScanQR}>\n              <text className=\"action-icon\">📷</text>\n              <text className=\"action-label\">宿主扫码</text>\n            </view>\n            <view className=\"action-btn\" bindtap={() => handleRequest(\"/api/v1/desk/list\")}>\n              <text className=\"action-icon\">🌐</text>\n              <text className=\"action-label\">网络代理</text>\n            </view>\n            <view className=\"action-btn\" bindtap={handleShowModal}>\n              <text className=\"action-icon\">💬</text>\n              <text className=\"action-label\">原生弹窗</text>\n            </view>\n            <view className=\"action-btn\" bindtap={() => handleToast(\"已成功调用宿主 Toast!\")}>\n              <text className=\"action-icon\">🔔</text>\n              <text className=\"action-label\">KTips Toast</text>\n            </view>\n          </view>\n\n          {/* Operation Result */}\n          <view className=\"result-card\">\n            <text className=\"result-title\">最新隧道执行结果:</text>\n            <text className=\"result-text\">{lastActionResult}</text>\n          </view>\n        </view>\n      )}\n    </view>\n  );\n}\n",
    "src/styles.css": "/* Lynx Mini-Program Styles */\n.container {\n  display: flex;\n  flex-direction: column;\n  padding: 14px;\n  background-color: #f5f6f8;\n  min-height: 100vh;\n}\n\n.header-card {\n  background: linear-gradient(135deg, #1890ff 0%, #36cfc9 100%);\n  border-radius: 12px;\n  padding: 16px;\n  margin-bottom: 12px;\n  box-shadow: 0 4px 12px rgba(24, 144, 255, 0.15);\n}\n\n.header-title {\n  font-size: 18px;\n  font-weight: bold;\n  color: #ffffff;\n  margin-bottom: 4px;\n}\n\n.header-subtitle {\n  font-size: 12px;\n  color: rgba(255, 255, 255, 0.85);\n}\n\n/* Tabs */\n.tabs-bar {\n  display: flex;\n  flex-direction: row;\n  background-color: #ffffff;\n  border-radius: 8px;\n  padding: 4px;\n  margin-bottom: 12px;\n}\n\n.tab-item {\n  flex: 1;\n  padding: 8px 0;\n  text-align: center;\n  border-radius: 6px;\n}\n\n.tab-active {\n  background-color: #e6f4ff;\n}\n\n.tab-text {\n  font-size: 12px;\n  color: #595959;\n}\n\n.tab-text-active {\n  color: #1890ff;\n  font-weight: bold;\n}\n\n.section-card {\n  background-color: #ffffff;\n  border-radius: 12px;\n  padding: 14px;\n  margin-bottom: 12px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);\n}\n\n.section-title {\n  font-size: 14px;\n  font-weight: 600;\n  color: #1f2937;\n  margin-bottom: 12px;\n}\n\n/* Desk Grid */\n.desk-grid {\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n.desk-card {\n  flex: 1 1 calc(50% - 10px);\n  background-color: #f9fafb;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n  padding: 12px;\n}\n\n.desk-name {\n  font-size: 13px;\n  font-weight: bold;\n  color: #111827;\n}\n\n.desk-cap {\n  font-size: 11px;\n  color: #6b7280;\n  margin-top: 4px;\n}\n\n.desk-amt {\n  font-size: 14px;\n  font-weight: bold;\n  color: #ef4444;\n  margin-top: 6px;\n}\n\n/* Dual Column Menu */\n.menu-container {\n  display: flex;\n  flex-direction: row;\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.cat-sidebar {\n  width: 80px;\n  background-color: #f3f4f6;\n}\n\n.cat-btn {\n  padding: 12px 6px;\n  text-align: center;\n}\n\n.cat-active {\n  background-color: #ffffff;\n  border-left: 3px solid #1890ff;\n}\n\n.cat-text {\n  font-size: 11px;\n  color: #374151;\n}\n\n.product-list {\n  flex: 1;\n  padding: 0 10px;\n}\n\n.product-row {\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px 0;\n  border-bottom: 1px solid #f3f4f6;\n}\n\n.product-info {\n  display: flex;\n  flex-direction: column;\n}\n\n.product-name {\n  font-size: 13px;\n  font-weight: 500;\n  color: #1f2937;\n}\n\n.product-price {\n  font-size: 13px;\n  font-weight: bold;\n  color: #ef4444;\n  margin-top: 2px;\n}\n\n.stepper {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 8px;\n}\n\n.step-btn {\n  width: 22px;\n  height: 22px;\n  border-radius: 11px;\n  border: 1px solid #d1d5db;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.step-add {\n  background-color: #1890ff;\n  border: none;\n  color: #ffffff;\n}\n\n.step-count {\n  font-size: 12px;\n  font-weight: bold;\n}\n\n/* VIP Card */\n.vip-hero-card {\n  background: linear-gradient(135deg, #2d3748 0%, #1a202c 100%);\n  border-radius: 10px;\n  padding: 16px;\n  margin-bottom: 12px;\n}\n\n.vip-title {\n  font-size: 15px;\n  font-weight: bold;\n  color: #ffd700;\n}\n\n.vip-sub {\n  font-size: 11px;\n  color: rgba(255, 255, 255, 0.7);\n  margin-top: 4px;\n}\n\n.coupon-item {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  background-color: #fff1f0;\n  border: 1px dashed #ffccc7;\n  border-radius: 8px;\n  padding: 10px;\n}\n\n.coupon-val {\n  font-size: 18px;\n  font-weight: bold;\n  color: #ff4d4f;\n  margin-right: 12px;\n}\n\n.coupon-info {\n  flex: 1;\n}\n\n.coupon-title {\n  font-size: 12px;\n  font-weight: 500;\n  color: #262626;\n}\n\n.coupon-sub {\n  font-size: 10px;\n  color: #8c8c8c;\n}\n\n.coupon-action {\n  background-color: #ff4d4f;\n  padding: 4px 10px;\n  border-radius: 12px;\n  color: #ffffff;\n  font-size: 11px;\n}\n\n/* Actions Grid */\n.actions-grid {\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n.action-btn {\n  flex: 1 1 calc(50% - 10px);\n  background-color: #ffffff;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n  padding: 12px 10px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n.action-icon {\n  font-size: 20px;\n  margin-bottom: 4px;\n}\n\n.action-label {\n  font-size: 12px;\n  color: #374151;\n  font-weight: 500;\n}\n\n.result-card {\n  background-color: #f9fafb;\n  border: 1px dashed #d1d5db;\n  border-radius: 8px;\n  padding: 10px;\n  margin-top: 10px;\n}\n\n.result-title {\n  font-size: 11px;\n  color: #9ca3af;\n  margin-bottom: 4px;\n}\n\n.result-text {\n  font-size: 11px;\n  color: #1f2937;\n  font-family: monospace;\n}\n\n/* Reports & Analytics Charts Styles */\n.report-header-row {\n  display: flex;\n  flex-direction: row;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 12px;\n}\n\n.period-selector {\n  display: flex;\n  flex-direction: row;\n  background-color: #f3f4f6;\n  border-radius: 12px;\n  padding: 2px;\n}\n\n.period-btn {\n  padding: 4px 10px;\n  border-radius: 10px;\n}\n\n.period-active {\n  background-color: #1890ff;\n}\n\n.period-text {\n  font-size: 11px;\n  color: #4b5563;\n}\n\n.period-active .period-text {\n  color: #ffffff;\n  font-weight: bold;\n}\n\n.export-btn {\n  background-color: #107c41;\n  padding: 5px 12px;\n  border-radius: 12px;\n}\n\n.export-text {\n  color: #ffffff;\n  font-size: 11px;\n  font-weight: 500;\n}\n\n/* KPI Matrix */\n.kpi-grid {\n  display: flex;\n  flex-direction: row;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-bottom: 12px;\n}\n\n.kpi-card {\n  flex: 1 1 calc(50% - 8px);\n  background-color: #f9fafb;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n  padding: 10px;\n}\n\n.kpi-title {\n  font-size: 11px;\n  color: #6b7280;\n}\n\n.kpi-val {\n  font-size: 16px;\n  font-weight: bold;\n  color: #111827;\n  margin-top: 4px;\n}\n\n.kpi-sub {\n  font-size: 10px;\n  color: #9ca3af;\n  margin-top: 2px;\n}\n\n.kpi-green { color: #10b981; font-weight: bold; }\n.kpi-orange { color: #f59e0b; font-weight: bold; }\n.kpi-purple { color: #8b5cf6; font-weight: bold; }\n\n/* Chart Card */\n.chart-card {\n  background-color: #ffffff;\n  border: 1px solid #e5e7eb;\n  border-radius: 10px;\n  padding: 12px;\n  margin-bottom: 12px;\n}\n\n.chart-title {\n  font-size: 13px;\n  font-weight: bold;\n  color: #1f2937;\n}\n\n.chart-sub {\n  font-size: 10px;\n  color: #9ca3af;\n  margin-top: 2px;\n  margin-bottom: 12px;\n}\n\n/* Bar Chart */\n.bar-chart-container {\n  display: flex;\n  flex-direction: row;\n  align-items: flex-end;\n  height: 120px;\n  padding-bottom: 6px;\n}\n\n.bar-col {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: flex-end;\n}\n\n.bar-tip {\n  font-size: 8px;\n  color: #ffffff;\n  background-color: #1f2937;\n  padding: 1px 3px;\n  border-radius: 3px;\n  margin-bottom: 2px;\n}\n\n.bar-pillar {\n  width: 14px;\n  border-radius: 3px 3px 0 0;\n  background-color: #bae0ff;\n}\n\n.pillar-active {\n  background: linear-gradient(180deg, #1890ff 0%, #0958d9 100%);\n}\n\n.bar-h-20 { height: 20px; }\n.bar-h-25 { height: 25px; }\n.bar-h-28 { height: 28px; }\n.bar-h-35 { height: 35px; }\n.bar-h-52 { height: 52px; }\n.bar-h-85 { height: 85px; }\n.bar-h-90 { height: 90px; }\n.bar-h-100 { height: 100px; }\n\n.bar-label {\n  font-size: 9px;\n  color: #6b7280;\n  margin-top: 4px;\n}\n\n.hour-detail-box {\n  background-color: #f9fafb;\n  border: 1px dashed #d1d5db;\n  border-radius: 6px;\n  padding: 6px 10px;\n  margin-top: 8px;\n}\n\n.hour-detail-text {\n  font-size: 10px;\n  color: #374151;\n  font-weight: 500;\n}\n\n/* Progress Stack Bar */\n.progress-stack-bar {\n  display: flex;\n  flex-direction: row;\n  height: 12px;\n  border-radius: 6px;\n  overflow: hidden;\n  margin-bottom: 10px;\n}\n\n.bar-seg { height: 100%; }\n.seg-blue { flex: 42; background-color: #1890ff; }\n.seg-cyan { flex: 26; background-color: #13c2c2; }\n.seg-orange { flex: 18; background-color: #fa8c16; }\n.seg-purple { flex: 14; background-color: #722ed1; }\n\n.legend-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.legend-row {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n}\n\n.legend-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 4px;\n  margin-right: 6px;\n}\n\n.dot-blue { background-color: #1890ff; }\n.dot-cyan { background-color: #13c2c2; }\n.dot-orange { background-color: #fa8c16; }\n.dot-purple { background-color: #722ed1; }\n\n.legend-name {\n  flex: 1;\n  font-size: 11px;\n  color: #374151;\n}\n\n.legend-amt {\n  font-size: 11px;\n  font-weight: bold;\n  color: #111827;\n  margin-right: 8px;\n}\n\n.legend-pct {\n  font-size: 11px;\n  color: #6b7280;\n  width: 32px;\n  text-align: right;\n}\n\n/* Top Sellers */\n.top-row {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  padding: 8px 0;\n  border-bottom: 1px solid #f3f4f6;\n}\n\n.top-badge {\n  width: 18px;\n  height: 18px;\n  border-radius: 9px;\n  background-color: #fef3c7;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-right: 8px;\n}\n\n.badge-text {\n  font-size: 10px;\n  font-weight: bold;\n  color: #b45309;\n}\n\n.top-info {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n\n.top-name {\n  font-size: 12px;\n  font-weight: 500;\n  color: #1f2937;\n}\n\n.top-sales {\n  font-size: 10px;\n  color: #9ca3af;\n}\n\n.top-money {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n}\n\n.top-rev {\n  font-size: 12px;\n  font-weight: bold;\n  color: #ef4444;\n}\n\n.margin-pill {\n  background-color: #ecfdf5;\n  padding: 1px 4px;\n  border-radius: 4px;\n  margin-top: 2px;\n}\n\n.margin-text {\n  font-size: 9px;\n  color: #059669;\n}\n",
    "src/bridge.ts": "/**\n * Type-safe JSBridge client SDK for Lynx Mini Programs communicating with Flutter host (KManager).\n */\n\ndeclare const lynx: any;\n\nexport interface BridgeResponse<T = any> {\n  callId: string;\n  code: number;\n  message: string;\n  data?: T;\n}\n\nexport interface SystemInfo {\n  platform: string;\n  osVersion: string;\n  screenWidth: number;\n  screenHeight: number;\n  pixelRatio: number;\n  language: string;\n}\n\nexport interface UserInfo {\n  userId?: string;\n  userName?: string;\n  phone?: string;\n  token?: string;\n  roles?: string[];\n  [key: string]: any;\n}\n\nexport interface RequestOptions {\n  url: string;\n  method?: \"GET\" | \"POST\" | \"PUT\" | \"DELETE\";\n  data?: any;\n  headers?: Record<string, string>;\n}\n\nexport class LynxBridge {\n  private static callbackMap = new Map<string, (res: BridgeResponse) => void>();\n  private static eventListeners = new Map<string, Set<(data: any) => void>>();\n\n  static {\n    // Listen for custom events dispatched from Flutter Host\n    if (typeof lynx !== \"undefined\" && lynx.getJSModule) {\n      try {\n        const globalEmitter = lynx.getJSModule(\"GlobalEventEmitter\");\n        if (globalEmitter && globalEmitter.addListener) {\n          globalEmitter.addListener(\"onFlutterEvent\", (event: { name: string; data: any }) => {\n            const listeners = LynxBridge.eventListeners.get(event.name);\n            if (listeners) {\n              listeners.forEach((cb) => cb(event.data));\n            }\n          });\n        }\n      } catch (_) {}\n    }\n  }\n\n  /**\n   * Low-level invoke method\n   */\n  static invoke<T = any>(method: string, params: Record<string, any> = {}, module = \"default\"): Promise<T> {\n    const callId = \"call_\" + Date.now() + \"_\" + Math.floor(Math.random() * 10000);\n\n    return new Promise((resolve, reject) => {\n      LynxBridge.callbackMap.set(callId, (res: BridgeResponse) => {\n        if (res.code === 0) {\n          resolve(res.data as T);\n        } else {\n          reject(new Error(res.message || \"Bridge invocation failed\"));\n        }\n      });\n\n      // Try invoking through Lynx native module if available\n      try {\n        if (typeof lynx !== \"undefined\" && lynx.getJSModule) {\n          const bridgeModule = lynx.getJSModule(\"LynxBridge\");\n          if (bridgeModule && bridgeModule.call) {\n            bridgeModule.call(module, method, params, callId, (res: BridgeResponse) => {\n              const cb = LynxBridge.callbackMap.get(callId);\n              if (cb) {\n                LynxBridge.callbackMap.delete(callId);\n                cb(res);\n              }\n            });\n            return;\n          }\n        }\n      } catch (_) {}\n\n      // Fallback: mock response for local testing\n      console.warn(`[LynxBridge] Native module not detected. Using local fallback for ${module}.${method}`);\n      setTimeout(() => {\n        const mockData = LynxBridge.getMockResponse(method, params);\n        const cb = LynxBridge.callbackMap.get(callId);\n        if (cb) {\n          LynxBridge.callbackMap.delete(callId);\n          cb({ callId, code: 0, message: \"ok\", data: mockData });\n        }\n      }, 100);\n    });\n  }\n\n  // --- Convenience Mini-Program APIs ---\n\n  static getSystemInfo(): Promise<SystemInfo> {\n    return LynxBridge.invoke<SystemInfo>(\"getSystemInfo\", {}, \"system\");\n  }\n\n  static getUserInfo(): Promise<UserInfo> {\n    return LynxBridge.invoke<UserInfo>(\"getUserInfo\", {}, \"user\");\n  }\n\n  static scanQRCode(): Promise<{ code: string }> {\n    return LynxBridge.invoke<{ code: string }>(\"scanQRCode\", {}, \"scanner\");\n  }\n\n  static request<T = any>(options: RequestOptions): Promise<T> {\n    return LynxBridge.invoke<T>(\"request\", options, \"network\");\n  }\n\n  static showToast(title: string, icon: \"success\" | \"error\" | \"none\" = \"none\", duration = 1500): Promise<void> {\n    return LynxBridge.invoke<void>(\"showToast\", { title, icon, duration }, \"ui\");\n  }\n\n  static showModal(title: string, content: string, showCancel = true): Promise<{ confirm: boolean; cancel: boolean }> {\n    return LynxBridge.invoke<{ confirm: boolean; cancel: boolean }>(\"showModal\", { title, content, showCancel }, \"ui\");\n  }\n\n  static setStorage(key: string, data: any): Promise<void> {\n    return LynxBridge.invoke<void>(\"setStorage\", { key, data }, \"storage\");\n  }\n\n  static getStorage<T = any>(key: string): Promise<{ data: T }> {\n    return LynxBridge.invoke<{ data: T }>(\"getStorage\", { key }, \"storage\");\n  }\n\n  static on(eventName: string, callback: (data: any) => void): void {\n    if (!LynxBridge.eventListeners.has(eventName)) {\n      LynxBridge.eventListeners.set(eventName, new Set());\n    }\n    LynxBridge.eventListeners.get(eventName)!.add(callback);\n  }\n\n  static off(eventName: string, callback: (data: any) => void): void {\n    LynxBridge.eventListeners.get(eventName)?.delete(callback);\n  }\n\n  private static getMockResponse(method: string, params: any): any {\n    switch (method) {\n      case \"getSystemInfo\":\n        return {\n          platform: \"iOS\",\n          osVersion: \"17.4\",\n          screenWidth: 390,\n          screenHeight: 844,\n          pixelRatio: 3,\n          language: \"zh_CN\",\n        };\n      case \"getUserInfo\":\n        return {\n          userId: \"10086\",\n          userName: \"管理员 (Admin)\",\n          phone: \"13800138000\",\n          token: \"mock_jwt_token_kmanager_2026\",\n          roles: [\"admin\", \"store_manager\"],\n        };\n      case \"scanQRCode\":\n        return { code: \"https://kmanager.example.com/desk/001\" };\n      case \"request\":\n        return { success: true, message: \"Mock response for \" + params.url };\n      default:\n        return {};\n    }\n  }\n}\n"
  },
  "compiled": {
    "version": "1.0.0",
    "target": "lynx-tasm-runtime",
    "modules": [
