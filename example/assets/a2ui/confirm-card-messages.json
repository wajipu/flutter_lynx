[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "xiaoke-confirm-card",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json",
      "sendDataModel": true
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "xiaoke-confirm-card",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": [
            "card-title",
            "card-status",
            "card-description",
            "row-product",
            "row-stock",
            "row-quantity",
            "row-actions"
          ]
        },
        {
          "id": "card-title",
          "component": "Text",
          "variant": "h3",
          "text": {
            "path": "/label/title"
          }
        },
        {
          "id": "card-status",
          "component": "Text",
          "variant": "caption",
          "text": {
            "path": "/statusText"
          }
        },
        {
          "id": "card-description",
          "component": "Text",
          "variant": "body",
          "text": {
            "path": "/label/description"
          }
        },
        {
          "id": "row-product",
          "component": "Row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            "label-product",
            "value-product"
          ]
        },
        {
          "id": "label-product",
          "component": "Text",
          "variant": "caption",
          "text": {
            "path": "/label/product"
          }
        },
        {
          "id": "value-product",
          "component": "Text",
          "text": {
            "path": "/payload/product"
          }
        },
        {
          "id": "row-stock",
          "component": "Row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            "label-stock",
            "value-stock"
          ]
        },
        {
          "id": "label-stock",
          "component": "Text",
          "variant": "caption",
          "text": {
            "path": "/label/stock"
          }
        },
        {
          "id": "value-stock",
          "component": "Text",
          "text": {
            "path": "/payload/stock"
          }
        },
        {
          "id": "row-quantity",
          "component": "Row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            "label-quantity",
            "value-quantity"
          ]
        },
        {
          "id": "label-quantity",
          "component": "Text",
          "variant": "caption",
          "text": {
            "path": "/label/quantity"
          }
        },
        {
          "id": "value-quantity",
          "component": "Text",
          "text": {
            "path": "/payload/quantity"
          }
        },
        {
          "id": "row-actions",
          "component": "Row",
          "justify": "spaceBetween",
          "align": "center",
          "children": [
            "btn-cancel",
            "btn-confirm"
          ]
        },
        {
          "id": "btn-cancel",
          "component": "Button",
          "variant": "borderless",
          "child": "btn-cancel-label",
          "action": {
            "event": {
              "name": "cancel",
              "context": {
                "confirmationId": {
                  "path": "/confirmationId"
                },
                "quantity": {
                  "path": "/payload/quantity"
                }
              }
            }
          }
        },
        {
          "id": "btn-cancel-label",
          "component": "Text",
          "text": {
            "path": "/label/cancel"
          }
        },
        {
          "id": "btn-confirm",
          "component": "Button",
          "variant": "primary",
          "child": "btn-confirm-label",
          "action": {
            "event": {
              "name": "confirm",
              "context": {
                "confirmationId": {
                  "path": "/confirmationId"
                },
                "quantity": {
                  "path": "/payload/quantity"
                }
              }
            }
          }
        },
        {
          "id": "btn-confirm-label",
          "component": "Text",
          "text": {
            "path": "/label/confirm"
          }
        }
      ]
    }
  }
]
